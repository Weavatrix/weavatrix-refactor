{
  "mcpServers": {
    "weavatrix-refactor": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "weavatrix-refactor@1.0.15",
        "mcp",
        "${workspaceFolder}",
        "--profile=refactor"
      ],
      "env": {
        "WEAVATRIX_ALLOW_SOURCE_EDITS": "1"
      }
    }
  }
}
